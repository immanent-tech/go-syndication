<channel>
<title>Link and enclosure validation</title>
<link>https://feed.example.com/</link>
<description>Test fixture: Link and enclosure validation</description>
<item>
<title>GOOD: https</title>
<link>https://example.com/a</link>
<enclosure url="https://example.com/a.mp3" length="1024" type="audio/mpeg" />
<description>x</description>
</item>
